rules_version = '2';

// Économie : `totalLux` uniquement via Admin / Cloud Functions (callables).
// Client : merge `highScore` / `inventory` / `activeSkinId` / `pseudo` / timestamps.
// IAP idempotence : collection `iap_grants` — aucun accès client (écriture Functions).
// Classement : `leaderboardPublic` (pseudo + score + updatedAt) — écriture Functions uniquement.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /// highScore ne baisse pas ; plafond anti-valeurs absurdes.
    function isValidHighScore() {
      let oldH = resource.data.get('highScore', 0);
      let newH = request.resource.data.get('highScore', oldH);
      return newH is int
        && newH >= oldH
        && newH >= 0
        && newH <= 100000000;
    }

    /// Inventaire : pas de retrait d’éléments (merge / arrayUnion côté client).
    function isInventoryMonotone() {
      let oldInv = resource.data.get('inventory', []);
      let newInv = request.resource.data.get('inventory', oldInv);
      return oldInv is list
        && newInv is list
        && newInv.hasAll(oldInv)
        && newInv.size() <= 200;
    }

    /// Les clients ne modifient plus totalLux (Cloud Function / Admin SDK uniquement).
    function totalLuxNotClientMutated() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalLux']);
    }

    /// Empêche l’ajout de champs arbitraires sur mise à jour (patch merge).
    function playerPatchKeysAllowlisted() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'highScore',
          'inventory',
          'activeSkinId',
          'pseudo',
        ]);
    }

    /// Aligné sur [OraclePseudo] : 1–15 caractères [A-Za-z0-9_].
    function isValidPseudoIfPresent() {
      return !request.resource.data.keys().hasAny(['pseudo'])
        || (request.resource.data.pseudo is string
            && request.resource.data.pseudo.size() >= 1
            && request.resource.data.pseudo.size() <= 15
            && request.resource.data.pseudo.matches('^[a-zA-Z0-9_]+$'));
    }

    function isValidActiveSkinIdIfPresent() {
      return !request.resource.data.keys().hasAny(['activeSkinId'])
        || (request.resource.data.activeSkinId is string
            && request.resource.data.activeSkinId.size() > 0
            && request.resource.data.activeSkinId.size() <= 64);
    }

    /// Empêche de référencer un skin non possédé.
    function isActiveSkinIdOwnedIfPresent() {
      let oldInv = resource.data.get('inventory', []);
      let newInv = request.resource.data.get('inventory', oldInv);
      let oldActive = resource.data.get('activeSkinId', '');
      let newActive = request.resource.data.get('activeSkinId', oldActive);
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeSkinId'])
        || (newInv is list && newInv.hasAny([newActive]));
    }

    /// Profil complet : lecture **réservée au propriétaire** (LUX, inventaire, etc.).
    /// Le classement lit `leaderboardPublic` (miroir via Cloud Function).
    match /players/{userId} {
      allow read: if isSignedIn() && isOwner(userId);

      allow create: if isSignedIn()
        && isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'highScore',
          'totalLux',
          'inventory',
          'activeSkinId',
          'lastSeen',
          'updatedAt',
        ])
        && request.resource.data.highScore is int
        && request.resource.data.highScore == 0
        && request.resource.data.totalLux is int
        && request.resource.data.totalLux == 0
        && request.resource.data.inventory is list
        && request.resource.data.inventory.size() > 0
        && request.resource.data.inventory.size() <= 200
        && request.resource.data.activeSkinId is string
        && request.resource.data.activeSkinId.size() > 0
        && request.resource.data.activeSkinId.size() <= 64
        && request.resource.data.lastSeen is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow update: if isSignedIn()
        && isOwner(userId)
        && totalLuxNotClientMutated()
        && playerPatchKeysAllowlisted()
        && isValidHighScore()
        && isInventoryMonotone()
        && isValidPseudoIfPresent()
        && isValidActiveSkinIdIfPresent()
        && isActiveSkinIdOwnedIfPresent();

      allow delete: if false;
    }

    /// Grants IAP (idempotence) — écrits uniquement par Cloud Functions (`velourGrantIapLux`).
    match /iap_grants/{grantId} {
      allow read, write: if false;
    }

    /// Vue classement (champs publics). Écriture Admin / trigger uniquement.
    match /leaderboardPublic/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
