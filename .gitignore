# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Préférences DevTools locales (généré par l’IDE)
devtools_options.yaml

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signature release Android (ne jamais versionner)
/android/key.properties
/android/*.jks
/android/*.keystore

# Captures d’écran accidentelles à la racine (`flutter run` / outils)
/flutter_*.png

# Secrets locaux (ne pas committer de clés API ici)
.env
.env.*
!.env.example
# Firebase Functions : fichier projet documenté (non secret) pour variables déployées via CLI.
!.env.velour-6690f

# Admin local : snapshots classement + liste d’UID à purger (ne pas committer)
functions/scripts/.local/
functions/scripts/uids-a-supprimer.txt

# Capture locale flutter logs (script scripts/capture_velour_ios_logs.sh)
velour_logs_capture.txt
velour_profile_session.txt
velour_ios_session.txt
velour_ios_session_*.txt
.audio_backup/
